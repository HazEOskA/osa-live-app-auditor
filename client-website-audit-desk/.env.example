# Required in production. Operators send it in the x-access-password header (UI field).
ACCESS_PASSWORD=
# Set to "true" ONLY for local dev/tests to run /api without ACCESS_PASSWORD.
ALLOW_OPEN_ACCESS=
# Optional. Without a key the app produces a deterministic template audit (source: "template").
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
AUDIT_MODEL=
